# Copy to apps/reader/.env and apps/console/.env.local. Local PostgreSQL is the default.
CONTENT_MODE=local
AUTH_MODE=local
LOCAL_CONTENT_URL=http://127.0.0.1:3202/app/api/public
# Optional external mode: set AUTH_MODE=supabase and CONTENT_MODE=supabase.
# Apply migrations, set the URL/public key, and generate a 32+ character COOKIE_SIGNING_KEY.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
COOKIE_SIGNING_KEY=
SITE_ORIGIN=http://localhost:3200
# Both applications use the same Supabase public key. Never add a service-role key.
