---
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadCatalog } from '../lib/catalog';
import { searchPosts, faNumber } from '@site/content';
const catalog = await loadCatalog().catch(() => null);
if (!catalog) return Astro.redirect('/unavailable', 302);
const query = (Astro.url.searchParams.get('q') ?? '').slice(0, 160);
const collection = Astro.url.searchParams.get('collection') ?? '';
const topic = Astro.url.searchParams.get('topic') ?? '';
const topics = [...new Set(catalog.posts.map((p) => p.topic))].filter(Boolean).sort();
const results = searchPosts(catalog.posts, query, collection).filter(
  (p) => !topic || p.topic === topic,
);
---

<SiteLayout title="جست‌وجو">
  <header class="page-heading">
    <h1>دنبال چه می‌گردی؟</h1>
  </header>
  <form class="search-form" action="/search">
    <label hidden for="query">
      عبارت جست‌وجو
    </label>
    <input id="query" name="q" value={query} placeholder="یک موضوع یا واژه…" maxlength="160" />
    <label hidden for="collection">
      مجموعه
    </label>
    <select id="collection" name="collection">
      <option value="">همه مجموعه‌ها</option>
      {catalog.collections.map((c) => (
        <option selected={c.slug === collection} value={c.slug}>
          {c.title}
        </option>
      ))}
    </select>
    <label hidden for="topic">
      موضوع
    </label>
    <select id="topic" name="topic">
      <option value="">همه موضوع‌ها</option>
      {topics.map((t) => (
        <option selected={t === topic} value={t}>
          {t}
        </option>
      ))}
    </select>
    <button class="primary-button" type="submit">
      جست‌وجو
    </button>
  </form>
  <p class="muted">{faNumber(results.length)} نتیجه</p>
  {results.length ? (
    <div class="episode-list">
      {results.map((p) => (
        <div class="episode-row">
          <a href={`/posts/${p.slug}`}>{p.title}</a>
          <span class="muted">{p.topic}</span>
        </div>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <h2>چیزی پیدا نشد</h2>
      <p>با واژه‌ای کوتاه‌تر یا مجموعه دیگری امتحان کن.</p>
      <a class="text-link" href="/search">
        پاک‌کردن فیلترها
      </a>
    </div>
  )}
</SiteLayout>
